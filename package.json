{
  "name": "whatsapp-bot",
  "version": "1.4.0",
  "description": "Multi-feature WhatsApp bot packed with AI and creative features, games, user system, media downloads, utilities and more",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "setup": "npm install",
    "clean": "rm -rf node_modules package-lock.json",
    "reinstall": "rm -rf node_modules package-lock.json && npm install",
    "pm2": "pm2 start index.js && pm2 log"
  },
  "dependencies": {
    "@google/generative-ai": "^0.1.3",
    "@hapi/boom": "^10.0.1",
    "@renpwn/fb-downloader": "^1.0.16",
    "@silent-tech-offc/ttdl": "^1.0.0",
    "@whiskeysockets/baileys": "^6.7.9",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "fluent-ffmpeg": "^2.1.2",
    "pdfkit": "^0.14.0",
    "pino": "^8.15.0",
    "qrcode": "^1.5.4",
    "shadowx-ytdl": "^1.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "termux",
    "multi-feature",
    "chatbot"
